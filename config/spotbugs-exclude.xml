<?xml version="1.0" encoding="UTF-8"?>
<!-- 每条排除都必须写明理由,新增前需评审。 -->
<FindBugsFilter>
  <!-- 生产环境日志经 LogstashEncoder 输出 JSON,换行符会被转义,不存在日志注入。 -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
  <!-- traceId 来自请求头,但已用白名单正则 [A-Za-z0-9-]{1,64} 校验后才写入响应头。 -->
  <Match>
    <Class name="io.oryxos.web.TraceIdFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER,SERVLET_HEADER"/>
  </Match>
  <!--
    会话实体 io.oryxos.storage.Session 与 core 的 Session 接口同名:实体名是课件与技术方案 9.2 的既定字面量,
    且分属不同包、实现处一律用全限定名引用接口,不会混淆;为过检查而改名会违反"不改已定字面量"。
  -->
  <Match>
    <Class name="io.oryxos.storage.Session"/>
    <Bug pattern="NM_SAME_SIMPLE_NAME_AS_INTERFACE"/>
  </Match>
  <!--
    Session.messages() 按第 17 节 Session 接口契约返回可变的消息序列:ReActLoop 与 PromptBuilder 直接读写它来累积历史,
    返回副本会让累积失效。该列表只在单次对话处理的线程内使用,不跨线程共享。
  -->
  <Match>
    <Class name="io.oryxos.storage.Session"/>
    <Method name="messages"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>
  <!--
    CliChannel 的输入输出流由构造器注入(生产环境是 System.in/out/err,测试里是内存流),持有调用方给的流正是设计本意:
    通道只往里写、不向外暴露,也不会替换其内容。拷贝一个 PrintStream 没有意义。
  -->
  <Match>
    <Class name="io.oryxos.channel.cli.CliChannel"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <!--
    WebhookNotifyAdapter 的 RestClient 由 Spring 注入(notifyRestClient),持有调用方给的客户端正是设计本意:
    RestClient 是线程安全、不可变的服务对象,适配器只用它发请求、不向外暴露也不替换,拷贝它没有意义。
  -->
  <Match>
    <Class name="io.oryxos.tool.notify.WebhookNotifyAdapter"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
