<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.oryxos</groupId>
    <artifactId>oryxos</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oryxos-provider</artifactId>
  <name>oryxos-provider</name>
  <properties>
    <!-- 集成冒烟要真调模型,日常与 CI 跳过;手动跑时清空此属性并指定 -Dgroups=integration -->
    <excluded.test.groups>integration</excluded.test.groups>
  </properties>
  <dependencies>
    <dependency><groupId>io.oryxos</groupId><artifactId>oryxos-core</artifactId></dependency>
    <!-- 审计写入 llm_calls 需要 LlmCallRepository -->
    <dependency><groupId>io.oryxos</groupId><artifactId>oryxos-storage</artifactId></dependency>
    <!-- Spring AI 仅用 Provider 抽象与协议转换;自动装配与自动工具执行均在 boot 配置中关闭 -->
    <dependency><groupId>org.springframework.ai</groupId><artifactId>spring-ai-starter-model-openai</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
          </includes>
          <excludedGroups>${excluded.test.groups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
